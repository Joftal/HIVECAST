{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HIVECAST",
  "version": "0.1.0",
  "identifier": "com.hivecast.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HIVECAST",
        "width": 1320,
        "height": 860,
        "minWidth": 1180,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: http://127.0.0.1:* http://localhost:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "publisher": "HIVECAST",
    "copyright": "© 2026 HIVECAST",
    "category": "Video",
    "shortDescription": "多平台直播录制与分屏观看",
    "longDescription": "HIVECAST 是一套桌面端直播工具：同时录制哔哩哔哩、斗鱼、虎牙、抖音的直播间，支持四路分屏观看、弹幕与媒体库管理。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
